{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "packages/web/dist",
  "functions": {
    "api/[[route]].ts": {
      "maxDuration": 60,
      "includeFiles": "data/skills/**, data/tools/**"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
