# ============================================================================
# ClawBot 演示环境变量（公开的演示值，仅配合 docker-compose.demo.yml 使用）
#
# 用法：
#   docker compose --env-file docker/demo.env \
#     -f docker-compose.yml -f docker-compose.demo.yml up -d
#
# 注意：这里的所有密钥都是公开仓库里的演示值，绝不能用于生产环境。
# ============================================================================

# ── Docker Compose 自带 PostgreSQL ─────────────────────────────────────────
POSTGRES_USER=clawbot
POSTGRES_PASSWORD=demo-postgres-password
POSTGRES_DB=clawbot
POSTGRES_PORT=55432

# ── 端口 ───────────────────────────────────────────────────────────────────
# Web 后台用 8080，避免与本机已有的正式部署（80 端口）冲突
API_PORT=18028
WEB_PORT=8080

# ── 凭据加密主密钥（演示值，64 位十六进制）─────────────────────────────────
CLAWBOT_CREDENTIAL_KEY=10fe955565037237e3ef60f31a5eb1cc7221d2dd44b156b18f24e92418745b81

# ── Web 后台登录账号（演示值）──────────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=demo-admin-2026
AUTH_JWT_SECRET=e0ddd2dfce72a28119282ea715b3c75d27617bffd82d2cffbf0f45815552f776
AUTH_TOKEN_EXPIRY=7d
