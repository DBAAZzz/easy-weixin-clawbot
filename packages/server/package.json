{
  "name": "@clawbot/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --conditions development src/index.ts",
    "build": "tsc",
    "test": "tsx --conditions development --test 'src/**/*.test.ts'",
    "test:fact-ledger-db": "tsx --conditions development --test --test-concurrency=1 'test-integration/*.test.ts'",
    "test:typecheck:integration": "tsc --noEmit -p test-integration/tsconfig.json",
    "start": "node dist/index.js",
    "assets:migrate-local-to-s3": "tsx --conditions development src/assets/migrate-local-to-s3.ts",
    "ingress:stuck": "tsx --conditions development src/ingress-admin.ts stuck",
    "ingress:resolve": "tsx --conditions development src/ingress-admin.ts resolve",
    "prisma:generate": "tsx src/prisma-cli.ts generate --schema prisma/schema.prisma",
    "prisma:validate": "tsx src/prisma-cli.ts validate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "tsx src/prisma-cli.ts migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:diff": "tsx src/prisma-cli.ts migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "prisma:migrate:status": "tsx src/prisma-cli.ts migrate status --schema prisma/schema.prisma",
    "lint": "oxlint"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.0",
    "@clawbot/asset": "workspace:*",
    "@clawbot/agent": "workspace:*",
    "@clawbot/exec": "workspace:*",
    "@clawbot/observability": "workspace:*",
    "@clawbot/shared": "workspace:*",
    "@clawbot/weixin-agent-sdk": "workspace:*",
    "@hono/node-server": "^1.19.11",
    "@prisma/client": "^6.19.2",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.7.1",
    "hono": "^4.12.9",
    "hono-pino": "^0.10.3",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/jsonwebtoken": "^9.0.10",
    "oxlint": "^1.59.0",
    "prisma": "^6.19.2",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  }
}
